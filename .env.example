# токен бота от @BotFather
BOT_TOKEN=
# твой Telegram ID (уведомления приходят сюда), узнать можно у @userinfobot
USER_ID=
# ключ из Google AI Studio
GEMINI_API_KEY=
# код, по которому бот пускает других пользователей (пусто = никого)
