# адрес прокси для Gemini и Telegram (контейнер proxy из docker-compose)
GEMINI_PROXY=http://proxy:1080
# TG_PROXY=  # если для Telegram нужен отдельный прокси

# кнопки Fluidd и камеры (пусто = кнопка не показывается)
WEBAPP_URL_1=https://printer.example.com
WEBAPP_URL_2=https://printer.example.com
WEBAPP_URL_3=https://printer.example.com
